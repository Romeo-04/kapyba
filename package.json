  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
